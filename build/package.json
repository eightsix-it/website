{
  "name": "eightsix-website",
  "version": "1.0.0",
  "private": true,
  "description": "Eight Six IT Engineering marketing site (static, deployed as a Cloudflare Worker)",
  "scripts": {
    "build": "tailwindcss -i src/tailwind.css -o ../tailwind.css --minify",
    "watch": "tailwindcss -i src/tailwind.css -o ../tailwind.css --watch",
    "serve": "cd .. && python3 -m http.server 8080",
    "test:mips": "node test-mips.cjs",
    "check:js": "node --check ../mips-intelligence.js && node --check ../site.js && node --check ../experience.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "html-validate": "^11.16.1",
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.17"
  }
}
