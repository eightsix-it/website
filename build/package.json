{
  "name": "eightsix-website",
  "version": "1.0.0",
  "private": true,
  "description": "Eight Six IT Engineering marketing site (static, deployed as a Cloudflare Worker)",
  "scripts": {
    "build": "tailwindcss -i src/tailwind.css -o ../tailwind.css --minify",
    "watch": "tailwindcss -i src/tailwind.css -o ../tailwind.css --watch",
    "serve": "cd .. && python3 -m http.server 8080"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
